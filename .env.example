NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_DONATION_URL=
NEXT_PUBLIC_DONATION_PROVIDER=
CONTACT_FORM_ENDPOINT=

# Sanity token with Editor role. Server only: donations are written with it.
SANITY_API_WRITE_TOKEN=

# Ameriabank vPOS. Test: https://servicestest.ameriabank.am/VPOS and VPOS_TEST_MODE=true
# (10 AMD, OrderID 4788001-4789000). Live mode also needs VPOS_ORDER_ID_START.
VPOS_API_URL=
VPOS_CLIENT_ID=
VPOS_USERNAME=
VPOS_PASSWORD=
VPOS_TEST_MODE=true
VPOS_ORDER_ID_START=
# Public origin the bank returns the donor to, e.g. https://ascel.am
VPOS_RETURN_ORIGIN=
# At least 24 random characters; the cron job sends it as "Authorization: Bearer ..."
CRON_SECRET=
